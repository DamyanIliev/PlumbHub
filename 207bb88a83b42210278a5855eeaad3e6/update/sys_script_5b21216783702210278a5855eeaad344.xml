        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    var userGroups = [];
    var gr = new GlideRecord('sys_user_grmember');
    gr.addQuery('user', gs.getUserID());
    gr.query();
    while (gr.next()) {
        userGroups.push(gr.group.toString());
    }

    // Filter the records to only include ones where the Assignment Group is in the user's groups
    if (userGroups.length > 0) {
        current.addQuery('assignment_group', 'IN', userGroups.join(','));
    } else {
        // If user has no groups, show nothing
        current.addQuery('sys_id', 'IS', 'EMPTY');
    }

})(current, previous);]]></script>
